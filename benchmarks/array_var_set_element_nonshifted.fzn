% array_var_set_element_nonshifted with 0-based index.
var set of 1..3: a;
var set of 1..3: b;
var 0..1: i;
var set of 1..3: s;
constraint set_card(a, 1);
constraint set_card(b, 2);
constraint array_var_set_element_nonshifted([a, b], i, s);
constraint int_eq(i, 1);
constraint set_card(s, 2);
solve satisfy;
