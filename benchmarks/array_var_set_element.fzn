% array_var_set_element with 1-based index over an explicit list.
var set of 1..3: a;
var set of 1..3: b;
var 1..2: i;
var set of 1..3: s;
constraint set_card(a, 2);
constraint set_card(b, 1);
constraint array_var_set_element([a, b], i, s);
constraint int_eq(i, 1);
constraint set_card(s, 2);
solve satisfy;
