% Element prunes indices whose cells are disjoint from the value.
array [1..3] of var 1..10: xs;
var 1..3: i;
var 7..7: v;
constraint array_var_int_element(xs, i, v);
constraint int_le(xs[1], 3);
constraint int_le(xs[2], 5);
% xs[3] can be 7; i must not stay at 1 or 2 once those upper bounds apply.
solve satisfy;
