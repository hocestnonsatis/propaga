% Solver-library aliases: fzn_* and array_int_lt
array [1..3] of var 1..3: x;
array [1..2] of var 1..2: a;
array [1..2] of var 1..2: b;

constraint fzn_all_different_int(x);
constraint array_int_lt(a, b);
constraint int_eq(a[1], 1);
constraint int_eq(a[2], 1);
constraint int_eq(b[1], 1);
constraint int_eq(b[2], 2);

solve satisfy;
